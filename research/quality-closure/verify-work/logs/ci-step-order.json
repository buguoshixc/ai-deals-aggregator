    "判定步骤三条分支齐（full / degraded（仅显式允许）/ fail-closed exit 1）",
    "verify.yml: allow_degraded_run = ${{ inputs.allow_degraded_run && 'true' || 'false' }}",
    "collect.yml: allow_degraded_run = ${{ inputs.allow_degraded_run && 'true' || 'false' }}\n\n      # 译文状态：门禁本身已经是硬检查，这里把清单写进 Summary，\n      # 点开就能看到「哪几条要人管、最老多少天」，不必翻日志。\n      - name: Translation status (advisory summary)\n        if: always()\n        continue-on-error: true\n        run: |\n          {\n            echo \"### 中文译文状态\"\n            echo '```'\n            node",
    "deploy.yml: allow_degraded_run = 'false'\n\n  build:\n    # 采集任务失败时（例如 strict 门禁没过）不发布，保留线上上一份好数据。\n    # 这一行是**逐字冻结**的：check-ci-consistency.js 的断言 (7b) 会比对它的完整文本。\n    if: github.event_name != 'workflow_run' || github.event.workflow_run.conclusion == 'success'\n    needs: prepublish\n    # 钉死 runner 版本而不是浮动标签：镜像换代（2026-10-19 起 latest 迁 Ubuntu 26）\n    # 不跟着漂，与 collect.ym",
