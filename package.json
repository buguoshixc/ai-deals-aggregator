{
  "name": "ai-deals-aggregator",
  "version": "2.0.0",
  "description": "AI 优惠聚合器 —— 每日自动采集国内外 AI 大模型的真实优惠与福利（新用户免费额度、学生/教育/非营利折扣）",
  "main": "scripts/collect.js",
  "private": true,
  "engines": {
    "node": ">=20.18.1"
  },
  "scripts": {
    "collect": "node scripts/collect.js",
    "collect:dry": "node scripts/collect.js --dry-run",
    "collect:list": "node scripts/collect.js --list",
    "collect:headless": "node scripts/collect.js --headless",
    "collect:headless:dry": "node scripts/collect.js --headless --dry-run",
    "collect:headless:list": "node scripts/collect.js --headless --list",
    "migrate": "node scripts/migrate.js",
    "migrate:audience": "node scripts/migrate.js --audience",
    "migrate:audience:dry": "node scripts/migrate.js --audience --dry-run",
    "migrate:audience:verify": "node scripts/tools/migrate-audience-verify.js",
    "validate": "node scripts/validate.js",
    "test": "node scripts/validate.js",
    "test:strict": "node scripts/validate.js --strict",
    "build": "node scripts/tools/build-local.js",
    "verify": "node scripts/tools/verify-site.js",
    "verify:shots": "node scripts/tools/verify-site.js --shots",
    "verify:baseline": "node scripts/tools/verify-site.js --json=research/_raw/ours-baseline/verify.json",
    "verify:regress": "node scripts/tools/verify-site.js --compare=research/_raw/ours-baseline/verify.json",
    "verify:prefold": "node scripts/tools/verify-site.js --compare=research/_raw/ours-baseline/verify-pre-fold.json",
    "selftest:zh": "node scripts/tools/zh-selftest.js",
    "selftest:expiry": "node scripts/tools/expiry-selftest.js",
    "selftest:text": "node scripts/tools/text-selftest.js",
    "selftest:audience": "node scripts/tools/audience-selftest.js",
    "selftest:provenance": "node scripts/tools/provenance-selftest.js",
    "selftest:health": "node scripts/tools/health-selftest.js",
    "selftest:app-token": "node scripts/tools/app-token-selftest.js",
    "todo:zh": "node scripts/tools/zh-todo.js",
    "check:zh": "node scripts/tools/zh-todo.js --check",
    "report:tier": "node scripts/tools/tier-report.js",
    "report:vendor": "node scripts/tools/tier-report.js --vendor",
    "report:audience": "node scripts/tools/audience-report.js",
    "check:reproducible": "node scripts/tools/check-reproducible.js",
    "check:ci": "node scripts/tools/check-ci-consistency.js",
    "rebuild": "node scripts/tools/rebuild-deals.js",
    "fixture:test": "node scripts/tools/fixture-test.js",
    "fixture:build": "node scripts/tools/build-fixtures.js",
    "ai:selftest": "node scripts/tools/ai-selftest.js",
    "ai:extract": "node scripts/ai/maintenance.js --task=extract",
    "ai:dedup": "node scripts/ai/maintenance.js --task=dedup",
    "ai:translate": "node scripts/ai/maintenance.js --task=translate",
    "ai:diagnose": "node scripts/ai/maintenance.js --task=diagnose",
    "ai:audit": "node scripts/ai/maintenance.js --task=audit",
    "ai:patch": "node scripts/ai/maintenance.js --task=patch",
    "ai:review": "node scripts/tools/ai-review.js",
    "ai:accept": "node scripts/tools/ai-accept.js",
    "ai:apply": "node scripts/tools/ai-apply.js",
    "ai:usage": "node scripts/tools/ai-usage.js",
    "ai:eval": "node scripts/tools/ai-eval.js",
    "zh:apply-candidates": "node scripts/tools/zh-apply-candidates.js",
    "audience:overrides:extract": "node scripts/tools/audience-overrides-extract.js",
    "fetch:logos": "node scripts/tools/fetch-logos.js",
    "serve": "node scripts/serve.js"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "cheerio": "^1.0.0"
  },
  "devDependencies": {
    "playwright-core": "^1.63.0"
  }
}
